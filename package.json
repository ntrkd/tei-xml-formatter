{
	"name": "tei-xml-fmt",
	"version": "1.1.0",
	"type": "module",
	"description": "format tei-xml documents",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/cjs/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ntrkd/tei-xml-formatter.git"
	},
	"keywords": [
		"tei-xml",
		"formatter",
		"language",
		"typescript",
		"ts"
	],
	"author": "ntrkd",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ntrkd/tei-xml-formatter/issues"
	},
	"homepage": "https://github.com/ntrkd/tei-xml-formatter#readme",
	"scripts": {
		"start": "tsc --watch",
		"build": "tsc",
		"postbuild": "esm2cjs --in ./dist/esm --out ./dist/cjs -l error",
		"lint": "biome lint --write",
		"test": "npm run build && node --test tests/*.test.mjs"
	},
	"devDependencies": {
		"@alcalzone/esm2cjs": "^1.1.2",
		"@biomejs/biome": "^2.6.2",
		"git-cliff": "^2.14.2",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"saxes": "^6.0.0"
	}
}
